{
	"name": "@org/source",
	"version": "0.0.0",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"@eslint/js": "^10.0.1",
			"@sveltejs/package": "^3.0.1",
			"@sveltejs/vite-plugin-svelte": "^7.3.1",
			"@tailwindcss/vite": "^4.3.3",
			"eslint": "^10.13.0",
			"eslint-plugin-svelte": "^3.23.1",
			"globals": "^17.13.0",
			"mode-watcher": "^1.1.0",
			"phosphor-svelte": "^3.1.1",
			"svelte": "^5.57.2",
			"svelte-check": "^4.7.7",
			"tailwindcss": "^4.3.3",
			"@types/bun": "^1.4.3",
			"typescript": "^6.0.3",
			"typescript-eslint": "^8.72.0",
			"vite": "^8.3.4",
			"vitest": "^5.0.5"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "bun nx run-many -t dev",
		"build": "bun nx run-many -t build",
		"preview": "bun nx run-many -t preview",
		"check": "bun nx run-many -t check",
		"check:root": "bunx tsc --noEmit -p tsconfig.json",
		"lint": "bun nx run-many -t lint",
		"lint:root": "bunx eslint oxfmt.config.ts eslint.config.ts",
		"format": "bun --bun oxfmt",
		"format:check": "bun --bun oxfmt --check",
		"prepare": "husky && bun nx run-many -t prepare",
		"release": "changeset git-tag"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "^3.0.3",
		"@eslint/js": "catalog:",
		"@nx/eslint-plugin": "23.3.0",
		"@types/bun": "catalog:",
		"eslint": "catalog:",
		"eslint-plugin-svelte": "catalog:",
		"husky": "^9.1.7",
		"nx": "23.3.0",
		"oxfmt": "^0.74.0",
		"typescript": "catalog:",
		"typescript-eslint": "catalog:"
	}
}
