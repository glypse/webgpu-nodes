{
	"name": "@org/source",
	"version": "0.0.0",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"@eslint/js": "^10.0.1",
			"@sveltejs/package": "^2.5.8",
			"@sveltejs/vite-plugin-svelte": "^7.2.0",
			"@tailwindcss/vite": "^4.3.3",
			"@typescript/native-preview": "^7.0.0-dev.20260707.2",
			"eslint": "^10.7.0",
			"eslint-plugin-svelte": "^3.21.0",
			"globals": "^17.7.0",
			"mode-watcher": "^1.1.0",
			"phosphor-svelte": "^3.1.0",
			"svelte": "^5.56.6",
			"svelte-check": "^4.7.3",
			"tailwindcss": "^4.3.3",
			"typescript-eslint": "^8.64.0",
			"vite": "^8.1.5"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "bun nx run-many -t dev",
		"build": "bun nx run-many -t build",
		"preview": "bun nx run-many -t preview",
		"check": "bun nx run-many -t check",
		"check:root": "bunx tsc --noEmit -p tsconfig.json",
		"lint": "bun nx run-many -t lint",
		"lint:root": "bunx eslint oxfmt.config.ts eslint.config.ts",
		"format": "bun --bun rsvelte-fmt",
		"format:check": "bun --bun rsvelte-fmt --check",
		"prepare": "husky && bun nx run-many -t prepare",
		"release": "changeset tag"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^0.7.0",
		"@changesets/cli": "^2.31.1",
		"@eslint/js": "catalog:",
		"@nx/eslint-plugin": "23.1.0",
		"@rsvelte/fmt": "^0.7.4",
		"@typescript/native-preview": "catalog:",
		"eslint": "catalog:",
		"eslint-plugin-svelte": "catalog:",
		"husky": "^9.1.7",
		"nx": "23.1.0",
		"oxfmt": "^0.61.0",
		"typescript-eslint": "catalog:"
	}
}
