{
	"name": "@org/source",
	"version": "0.0.0",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"dev": "bun nx run-many -t dev",
		"build": "bun nx run-many -t build",
		"preview": "bun nx run-many -t preview",
		"check": "bun nx run-many -t check",
		"check:root": "bunx tsc --noEmit -p tsconfig.json",
		"lint": "bun nx run-many -t lint",
		"lint:root": "bunx eslint oxfmt.config.ts eslint.config.ts",
		"format": "bun --bun oxfmt",
		"format:check": "bun --bun oxfmt --check",
		"prepare": "husky && bun nx run-many -t prepare",
		"release": "changeset tag"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^0.7.0",
		"@changesets/cli": "^2.31.0",
		"@eslint/js": "^10.0.1",
		"@nx/eslint-plugin": "23.0.1",
		"@types/node": "^26.1.0",
		"@typescript/native-preview": "^7.0.0-dev.20260707.2",
		"eslint": "^10.6.0",
		"eslint-plugin-svelte": "^3.20.0",
		"husky": "^9.1.7",
		"nx": "23.0.1",
		"oxfmt": "^0.58.0",
		"typescript-eslint": "^8.63.0"
	}
}
