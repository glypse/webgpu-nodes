{
	"description": "Duplicated nodes come with the links between them, and none to what they were linked to outside.",
	"project": {
		"definitions": {
			"__root__": {
				"nodes": [
					{
						"id": "out",
						"type": "frag-output",
						"data": {},
						"position": {
							"x": 0,
							"y": 0
						}
					},
					{
						"id": "t",
						"type": "time",
						"data": {},
						"position": {
							"x": 0,
							"y": 0
						}
					},
					{
						"id": "sum",
						"type": "add",
						"data": {},
						"position": {
							"x": 0,
							"y": 0
						}
					}
				],
				"edges": [
					{
						"id": "t.seconds->sum.operands",
						"source": "t",
						"sourceHandle": "seconds",
						"target": "sum",
						"targetHandle": "operands"
					},
					{
						"id": "sum.result->out.color",
						"source": "sum",
						"sourceHandle": "result",
						"target": "out",
						"targetHandle": "color"
					}
				]
			}
		}
	},
	"commands": [
		{
			"kind": "duplicateNodes",
			"args": [["t", "sum"]]
		}
	],
	"expect": {
		"results": [["id1", "id2"]],
		"documents": {
			"": {
				"links": [
					"id1.seconds -> id2.operands",
					"sum.result -> out.color",
					"t.seconds -> sum.operands"
				]
			}
		}
	}
}
