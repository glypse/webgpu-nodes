					"to": 3
				}
			},
			"output": "result",
			"tolerance": {
				"abs": 0,
				"rel": 0
			}
		},
		{
			"note": "vec3f sweep",
			"types": {
				"e": "vec3f"
			},
			"inputs": {
				"e": {
					"kind": "uv",
					"from": -3,
					"to": 3
				}
			},
			"output": "result",
			"tolerance": {
				"abs": 0,
				"rel": 0
			}
		}
	]
