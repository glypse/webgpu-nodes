			"output": "result",
			"expect": [7]
		},
		{
			"note": "leaves the largest u32 unchanged",
			"types": {
				"e": "u32"
			},
			"inputs": {
				"e": [[4294967295]]
			},
			"output": "result",
			"expect": [4294967295]
