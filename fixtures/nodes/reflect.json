{
	"node": "reflect",
	"cases": [
		{
			"note": "reflects vec2f about a unit normal",
			"types": {
				"e1": "vec2f"
			},
			"inputs": {
				"e1": [[1, -1]],
				"e2": [[0, 1]]
			},
			"output": "result",
			"expect": [1, 1]
		},
		{
			"note": "reflects vec3f about a unit normal",
			"types": {
				"e1": "vec3f"
			},
			"inputs": {
				"e1": [[1, -2, 3]],
				"e2": [[0, 1, 0]]
			},
			"output": "result",
			"expect": [1, 2, 3]
		},
		{
			"note": "gives a vector along the normal pointing back",
			"types": {
				"e1": "vec3f"
			},
			"inputs": {
				"e1": [[0, -2, 0]],
				"e2": [[0, 1, 0]]
			},
			"output": "result",
			"expect": [0, 2, 0]
		}
	],
	"sweeps": [
		{
			"note": "vec2f sweep about the y axis",
			"types": {
				"e1": "vec2f"
			},
			"inputs": {
				"e1": {
					"kind": "uv",
					"from": -2,
					"to": 2
				},
				"e2": {
					"kind": "constant",
					"value": [0, 1]
				}
			},
			"output": "result",
			"tolerance": {
				"abs": 0.000001,
				"rel": 0.000001
			}
		},
		{
			"note": "vec3f sweep about the z axis",
			"types": {
				"e1": "vec3f"
			},
			"inputs": {
				"e1": {
					"kind": "uv",
					"from": -2,
					"to": 2
				},
				"e2": {
					"kind": "constant",
					"value": [0, 0, 1]
				}
			},
			"output": "result",
			"tolerance": {
				"abs": 0.000001,
				"rel": 0.000001
			}
		}
	]
}
