{
	"node": "cross",
	"cases": [
		{
			"note": "gives the right-handed perpendicular of x and y",
			"types": {
				"e1": "vec3f"
			},
			"inputs": {
				"e1": [[1, 0, 0]],
				"e2": [[0, 1, 0]]
			},
			"output": "result",
			"expect": [0, 0, 1],
			"tolerance": {
				"abs": 0.000001,
				"rel": 0.000001
			}
		},
		{
			"note": "gives the cross product of two vec3f",
			"types": {
				"e1": "vec3f"
			},
			"inputs": {
				"e1": [[1, 2, 3]],
				"e2": [[4, 5, 6]]
			},
			"output": "result",
			"expect": [-3, 6, -3],
			"tolerance": {
				"abs": 0.000001,
				"rel": 0.000001
			}
		},
		{
			"note": "gives 0 for parallel vectors",
			"types": {
				"e1": "vec3f"
			},
			"inputs": {
				"e1": [[1, 2, 3]],
				"e2": [[2, 4, 6]]
			},
			"output": "result",
			"expect": [0, 0, 0],
			"tolerance": {
				"abs": 0.000001,
				"rel": 0.000001
			}
		}
	],
	"sweeps": [
		{
			"note": "vec3f sweep",
			"types": {
				"e1": "vec3f"
			},
			"inputs": {
				"e1": {
					"kind": "uv",
					"from": -2,
					"to": 2
				},
				"e2": {
					"kind": "constant",
					"value": [1, 2, 3]
				}
			},
			"output": "result",
			"tolerance": {
				"abs": 0.000001,
				"rel": 0.000001
			}
		}
	]
}
