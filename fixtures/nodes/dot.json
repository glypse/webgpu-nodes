{
	"node": "dot",
	"cases": [
		{
			"note": "sums the products of vec2f",
			"types": {
				"e1": "vec2f"
			},
			"inputs": {
				"e1": [[1, 2]],
				"e2": [[3, 4]]
			},
			"output": "result",
			"expect": [11],
			"tolerance": {
				"abs": 0,
				"rel": 0
			}
		},
		{
			"note": "sums the products of vec3f",
			"types": {
				"e1": "vec3f"
			},
			"inputs": {
				"e1": [[1, -2, 3]],
				"e2": [[4, 5, -6]]
			},
			"output": "result",
			"expect": [-24],
			"tolerance": {
				"abs": 0,
				"rel": 0
			}
		},
		{
			"note": "sums the products of vec4f",
			"types": {
				"e1": "vec4f"
			},
			"inputs": {
				"e1": [[1, 2, 3, 4]],
				"e2": [[1, 1, 1, 1]]
			},
			"output": "result",
			"expect": [10],
			"tolerance": {
				"abs": 0,
				"rel": 0
			}
		},
		{
			"note": "gives 0 for perpendicular vectors",
			"types": {
				"e1": "vec2f"
			},
			"inputs": {
				"e1": [[1, 0]],
				"e2": [[0, -3]]
			},
			"output": "result",
			"expect": [0],
			"tolerance": {
				"abs": 0,
				"rel": 0
			}
		}
	],
	"sweeps": [
