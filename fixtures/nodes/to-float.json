{
	"node": "to-float",
	"cases": [
		{
			"note": "converts f32 as it is",
			"types": {
				"e": "f32"
			},
			"inputs": {
				"e": [[0.1]]
			},
			"output": "result",
			"expect": [0.10000000149011612]
		},
		{
			"note": "converts a negative i32",
			"types": {
				"e": "i32"
			},
			"inputs": {
				"e": [[-7]]
			},
			"output": "result",
			"expect": [-7]
		},
		{
			"note": "converts the top u32 to 2^32",
			"types": {
				"e": "u32"
