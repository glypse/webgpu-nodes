{
	"node": "normalize",
	"cases": [
		{
			"note": "divides by the length",
			"types": {
				"e": "vec2f"
			},
			"inputs": {
				"e": [[3, 4]]
			},
			"output": "result",
			"expect": [0.6, 0.8],
			"tolerance": {
				"abs": 0.000001,
				"rel": 0.000001
			}
		},
		{
			"note": "normalizes vec3f",
			"types": {
				"e": "vec3f"
			},
			"inputs": {
				"e": [[0, 0, 2]]
			},
			"output": "result",
			"expect": [0, 0, 1],
			"tolerance": {
				"abs": 0.000001,
				"rel": 0.000001
			}
		},
		{
			"note": "normalizes vec4f",
			"types": {
				"e": "vec4f"
			},
			"inputs": {
				"e": [[0, -5, 0, 0]]
			},
			"output": "result",
			"expect": [0, -1, 0, 0],
			"tolerance": {
				"abs": 0.000001,
				"rel": 0.000001
			}
		},
		{
			"note": "keeps a unit vector",
			"types": {
				"e": "vec2f"
			},
			"inputs": {
				"e": [[0, -1]]
			},
			"output": "result",
			"expect": [0, -1],
			"tolerance": {
				"abs": 0.000001,
				"rel": 0.000001
			}
		}
	],
	"sweeps": [
		{
			"note": "vec2f sweep",
			"types": {
				"e": "vec2f"
			},
			"inputs": {
				"e": {
					"kind": "uv",
					"from": -2,
					"to": 2
				}
			},
			"output": "result",
			"tolerance": {
				"abs": 0.000001,
				"rel": 0.000001
			}
		},
		{
			"note": "vec3f sweep",
			"types": {
				"e": "vec3f"
			},
			"inputs": {
				"e": {
					"kind": "uv",
					"from": -2,
					"to": 2
				}
			},
			"output": "result",
			"tolerance": {
				"abs": 0.000001,
				"rel": 0.000001
			}
		},
		{
			"note": "vec4f sweep",
			"types": {
				"e": "vec4f"
			},
			"inputs": {
				"e": {
					"kind": "uv",
					"from": -2,
					"to": 2
				}
			},
			"output": "result",
			"tolerance": {
				"abs": 0.000001,
				"rel": 0.000001
			}
		}
	]
}
