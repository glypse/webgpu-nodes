{
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"name": "theme",
	"projectType": "library",
	"root": "packages/theme",
	"sourceRoot": "packages/theme/src",
	"targets": {
		"build": {
			"executor": "nx:run-commands",
			"dependsOn": ["^build"],
			"outputs": ["{projectRoot}/dist"],
			"options": {
				"command": "bun --bun svelte-package",
				"cwd": "{projectRoot}"
			}
		},
		"check": {
			"executor": "nx:run-commands",
			"options": {
				"command": "bun --bun svelte-check --tsconfig ./tsconfig.json",
				"cwd": "{projectRoot}"
			}
		},
		"test": {
			"executor": "nx:run-commands",
			"options": {
				"command": "bun --bun vitest run",
				"cwd": "{projectRoot}"
			}
		},
		"lint": {
			"executor": "nx:run-commands",
			"options": {
				"commands": ["bun --bun oxfmt --check", "bun --bun eslint ."],
				"cwd": "{projectRoot}"
			}
		},
		"lint:fix": {
			"executor": "nx:run-commands",
			"options": {
				"command": "bun --bun oxfmt && bun --bun eslint . --fix",
				"cwd": "{projectRoot}"
			}
		}
	}
}
