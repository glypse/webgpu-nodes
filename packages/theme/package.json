{
	"name": "$theme",
	"version": "0.3.0",
	"private": true,
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"exports": {
		".": {
			"development": "./src/lib/index.ts",
			"svelte": "./dist/index.js",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./css": {
			"development": "./src/lib/index.css",
			"default": "./dist/index.css"
		},
		"./utils": {
			"development": "./src/lib/utils.ts",
			"import": "./dist/utils.js",
			"default": "./dist/utils.js"
		},
		"./utils.js": {
			"development": "./src/lib/utils.ts",
			"import": "./dist/utils.js",
			"default": "./dist/utils.js"
		},
		"./components/ui": {
			"development": "./src/lib/components/ui/index.ts",
			"svelte": "./dist/components/ui/index.js",
			"import": "./dist/components/ui/index.js",
			"default": "./dist/components/ui/index.js"
		}
	},
	"dependencies": {
		"$core": "workspace:*",
		"@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
		"bits-ui": "^2.20.0",
		"clsx": "^2.1.1",
		"phosphor-svelte": "catalog:",
		"shadcn-svelte": "^1.7.0",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@sveltejs/package": "catalog:",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@tailwindcss/vite": "catalog:",
		"globals": "catalog:",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:"
	},
	"peerDependencies": {
		"svelte": "catalog:",
		"tailwindcss": "catalog:"
	}
}
