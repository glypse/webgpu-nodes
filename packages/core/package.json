{
	"name": "$core",
	"version": "0.1.0",
	"private": true,
	"description": "Headless graph model and WGSL code generation for webgpu-nodes",
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/testing"
	],
	"type": "module",
	"sideEffects": false,
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"development": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./testing": {
			"development": "./src/testing/index.ts",
			"default": "./src/testing/index.ts"
		}
	},
	"scripts": {
		"perf": "bun --conditions=development scripts/perf.ts",
		"scene:build": "bun scripts/scene/build.ts",
		"schema:build": "bun scripts/schema.ts",
		"stdlib:archive": "bun scripts/archive-stdlib.ts",
		"stdlib:build": "bun scripts/stdlib/build.ts"
	},
	"dependencies": {
		"@leeoniya/ufuzzy": "^1.0.19",
		"elkjs": "^0.12.0",
		"fflate": "^0.8.3",
		"valibot": "^1.5.0"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"@valibot/to-json-schema": "^1.8.0",
		"ajv": "^8.20.0",
		"eslint": "catalog:",
		"globals": "catalog:",
		"typescript": "catalog:",
		"typescript-eslint": "catalog:"
	}
}
