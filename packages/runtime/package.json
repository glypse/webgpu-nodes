{
	"name": "$runtime",
	"version": "0.0.0",
	"private": true,
	"description": "WebGPU runtime drawing the shader programs webgpu-nodes generates",
	"files": [
		"dist",
		"!dist/**/*.test.*"
	],
	"type": "module",
	"sideEffects": false,
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"development": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"dependencies": {
		"$core": "workspace:*",
		"@webgpu/types": "^0.1.74"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"eslint": "catalog:",
		"globals": "catalog:",
		"typescript": "catalog:",
		"typescript-eslint": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	}
}
